{
  "name": "@espadat/motus",
  "version": "1.1.0",
  "description": "Keep API keys and tokens out of your AI coding agent. Redacts exact secret values from tool output and session files in pi, and blocks credential files and printing commands in pi and Claude Code. Fails closed.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "secrets",
    "redaction",
    "redact",
    "secret-scanning",
    "security",
    "mise",
    "age",
    "claude-code"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/espadat-studio/motus.git"
  },
  "type": "module",
  "bin": {
    "motus-cc-hook": "bin/motus-cc-hook.js"
  },
  "files": [
    "bin",
    "extensions",
    "src"
  ],
  "pi": {
    "extensions": [
      "./extensions/motus.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "smol-toml": "1.9.1"
  }
}
