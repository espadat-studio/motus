    "security",
    "mise",
    "age",
    "claude-code"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/espadat-studio/motus.git"
  },
  "type": "module",
  "files": [
    "extensions",
    "src"
  ],
  "pi": {
    "extensions": [
      "./extensions/motus.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0"
